# Copy to .env. Everything has a working default for local use.

# --- docker compose ---
POSTGRES_PASSWORD=kebera          # change for any shared or hosted install
KEBERA_WEB_PORT=8080
KEBERA_API_PORT=8000
# KEBERA_DOMAIN=app.kebera.com    # production only (docker-compose.prod.yml)

# --- API and worker (prefix KEBERA_, read by backend/app/core/config.py) ---
# KEBERA_DATABASE_URL=postgresql+psycopg://kebera:kebera@localhost:5432/kebera   # set to use your own database
KEBERA_SCHEDULES_ENABLED=0        # 1: the worker runs the scheduled tasks
KEBERA_LOG_LEVEL=INFO
# KEBERA_LOG_JSON=0               # readable logs instead of JSON lines
