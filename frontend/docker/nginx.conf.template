# Rendered by the nginx image at start (envsubst fills in ${KEBERA_API_URL}).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size 100m;  # client documents are uploaded through /api/

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location = /healthz { access_log off; return 200 "ok\n"; }

    # The API on the same origin, so cookies just work and CORS isn't needed.
    location /api/ {
        proxy_pass ${KEBERA_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Hashed build files never change; cache them for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes all load index.html, which must never be cached.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
